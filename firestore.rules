rules_version = '2';

// Reglas de seguridad de Lusito Gym Tracker.
// Cada persona que entra con su cuenta de Google recibe su propia carpeta
// users/{uid} y SOLO puede leer y escribir dentro de ella.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Todo lo que no este explicitamente permitido, queda prohibido.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
